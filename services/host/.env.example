# Claude API-sleutel
ANTHROPIC_API_KEY=sk-ant-...

# Claude-modus
CLAUDE_MODEL=claude-sonnet-4-6

# VLAM-modus (UbiOps/Mistral)
VLAM_API_KEY=...
VLAM_BASE_URL=https://api...
VLAM_MODEL_ID=ubiops-deployment/...


# MCP-servers (pad naar server-scripts)
MCP_SERVER_KVK=../mcp/kvk/server.py
MCP_SERVER_KOOP=../mcp/koop/server.py
MCP_SERVER_REGELRECHT=../mcp/regelrecht/server.py
MCP_SERVER_RVO=../mcp/rvo/server.py
MCP_SERVER_NETBEHEERDER=../mcp/netbeheerder/server.py

# BAG API Individuele Bevragingen (Kadaster) voor live woonfunctie/gebruiksdoel.
# Gratis API-key aanvragen bij Kadaster (sinds 1-3-2023 verplicht een eigen key).
# Zonder key gebruikt de KvK-server demo-data voor de bekende demo-adressen.
# BAG_API_KEY=...

# RegelRecht engine (poc-machine-law) JSON-RPC endpoint. De code-default wijst naar
# de actuele demo-host; override hier als die verhuist.
# REGELRECHT_RPC_URL=https://ui.lac.projects.digilab.network/mcp/rpc

# Testgebruikers: token -> KvK-nummer (MVP-01/PDR-009). De frontend stuurt per
# request de header `X-Test-User: <token>`; de host mapt dat token server-side
# naar het KvK-nummer en injecteert dat bij elke bron-aanroep. Zonder geldig
# token blokkeert de host (nette "log eerst in"-melding, geen bron geraadpleegd).
# Formaat: komma-gescheiden `token:kvk`-paren. Kies niet-raadbare tokens: dit is
# een bearer-credential, ook al is het maar een gesloten testgroep.
# De drie testprofielen hebben mockdata in de KvK- en netbeheerder-server en
# corresponderen met de persona-id's in de frontend (`MinBZK/moza-poc`):
#   85234567 = Koffiezaak Noon      (persona koffiezaak)   — informatieplicht geldt
#   62345681 = Kwekerij De Bloesem  (persona bloemenkweker) — geldt, via gasverbruik
#   56789012 = Roots & Locks        (persona haarstylist)   — geldt niet, onder drempel
# Overige persona's hebben bewust geen token: de assistent antwoordt dan
# "log eerst in". 68750110 (Test BV Donald) komt uit de KvK Test API en heeft
# geen persona in de frontend.
# TEST_USERS=tok_koffiezaak:85234567,tok_bloemenkweker:62345681,tok_haarstylist:56789012

# Dev-fallback KvK-nummer voor de KvK-server bij STANDALONE gebruik (buiten de
# host, zonder sessie). NIET nodig als de host draait; die injecteert het
# sessie-KvK. Er is geen hardcoded demo-bedrijf meer.
# DEMO_KVK_NUMMER=85234567

# Host-instellingen
VLAM_HOST=0.0.0.0
VLAM_PORT=8000

# Security
# CORS: komma-gescheiden whitelist. Leeg laten = geen CORS toegestaan (veilige
# default). Zet expliciet "*" voor lokale dev/PoC (alleen op je eigen machine)
# of een concrete whitelist voor productie:
#   ALLOWED_ORIGINS=https://moza.overheid.nl,https://moza-test.overheid.nl
ALLOWED_ORIGINS=http://localhost:8080
# API-keys via request-headers accepteren (x-vlam-api-key / x-claude-api-key).
# Default: false. Zet op true voor demos waarin de frontend een eigen key meestuurt.
ALLOW_API_KEY_OVERRIDE=false
