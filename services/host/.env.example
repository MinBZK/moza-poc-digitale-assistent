# Claude API-sleutel
ANTHROPIC_API_KEY=sk-ant-...

# Claude-modus
CLAUDE_MODEL=claude-sonnet-4-6

# VLAM-modus (UbiOps/Mistral)
VLAM_API_KEY=...
VLAM_BASE_URL=https://api...
VLAM_MODEL_ID=ubiops-deployment/...


# MCP-servers (pad naar server-scripts)
MCP_SERVER_KVK=../mcp/kvk/server.py
MCP_SERVER_KOOP=../mcp/koop/server.py
MCP_SERVER_REGELRECHT=../mcp/regelrecht/server.py
MCP_SERVER_RVO=../mcp/rvo/server.py
MCP_SERVER_NETBEHEERDER=../mcp/netbeheerder/server.py

# BAG API Individuele Bevragingen (Kadaster) voor live woonfunctie/gebruiksdoel.
# Gratis API-key aanvragen bij Kadaster (sinds 1-3-2023 verplicht een eigen key).
# Zonder key gebruikt de KvK-server demo-data voor de bekende demo-adressen.
# BAG_API_KEY=...

# RegelRecht engine (poc-machine-law) JSON-RPC endpoint. De code-default wijst naar
# de actuele demo-host; override hier als die verhuist.
# REGELRECHT_RPC_URL=https://ui.lac.projects.digilab.network/mcp/rpc

# Toegestane KvK-nummers voor de gesloten testgroep (MVP-01/PDR-009). De frontend
# stuurt `X-Test-User: <kvk-nummer>` van de gekozen persona; staat het nummer niet
# in deze lijst, dan blokkeert de host met "log eerst in" en raadpleegt geen bron.
# Geen geheim (de nummers staan publiek in de frontend), wel een grens.
# De drie profielen hebben mockdata in de KvK- en netbeheerder-server:
#   85234567 = Koffiezaak Noon     (persona koffiezaak)    — plicht via elektriciteit
#   62345681 = Kwekerij De Bloesem (persona bloemenkweker) — plicht via gas
#   56789012 = Roots & Locks       (persona haarstylist)   — geen plicht
# TEST_KVK_NUMMERS=85234567,62345681,56789012

# Dev-fallback KvK-nummer voor de KvK-server bij STANDALONE gebruik (buiten de
# host, zonder sessie). NIET nodig als de host draait; die injecteert het
# sessie-KvK. Er is geen hardcoded demo-bedrijf meer.
# DEMO_KVK_NUMMER=85234567

# Host-instellingen
VLAM_HOST=0.0.0.0
VLAM_PORT=8000

# Security
# CORS: komma-gescheiden whitelist. Leeg laten = geen CORS toegestaan (veilige
# default). Zet expliciet "*" voor lokale dev/PoC (alleen op je eigen machine)
# of een concrete whitelist voor productie:
#   ALLOWED_ORIGINS=https://moza.overheid.nl,https://moza-test.overheid.nl
ALLOWED_ORIGINS=http://localhost:8080
# API-keys via request-headers accepteren (x-vlam-api-key / x-claude-api-key).
# Default: TRUE, en dat is een bewuste keuze — zie PDR-010. De deployment draait
# zonder LLM-sleutels; elke tester brengt zijn eigen sleutel mee via de UI. Zo is
# er geen gedeelde sleutel die leeggetrokken kan worden op een host die (nog)
# geen authenticatie op /chat heeft.
# Spelregels die daarbij horen:
#   - alleen over HTTPS, en met ALLOWED_ORIGINS op een concrete whitelist;
#   - de frontend bewaart de sleutel in het browsergeheugen of sessionStorage,
#     nooit in localStorage en nooit in een URL.
# Zet op false zodra er wél server-sleutels staan (ANTHROPIC_API_KEY /
# VLAM_API_KEY hierboven); de header wordt dan genegeerd.
ALLOW_API_KEY_OVERRIDE=true
