# Claude API-sleutel
ANTHROPIC_API_KEY=sk-ant-...

# Claude-modus
CLAUDE_MODEL=claude-sonnet-4-20250514

# VLAM-modus (UbiOps/Mistral)
VLAM_API_KEY=...
VLAM_BASE_URL=https://api...
VLAM_MODEL_ID=ubiops-deployment/...


# MCP-servers (pad naar server-scripts)
MCP_SERVER_KVK=../mcp/kvk/server.py
MCP_SERVER_KOOP=../mcp/koop/server.py
MCP_SERVER_REGELRECHT=../mcp/regelrecht/server.py
MCP_SERVER_RVO=../mcp/rvo/server.py
MCP_SERVER_NETBEHEERDER=../mcp/netbeheerder/server.py

# BAG API Individuele Bevragingen (Kadaster) voor live woonfunctie/gebruiksdoel.
# Gratis API-key aanvragen bij Kadaster (sinds 1-3-2023 verplicht een eigen key).
# Zonder key gebruikt de KvK-server demo-data voor de bekende demo-adressen.
# BAG_API_KEY=...

# Demo-persona (sessie-gebonden KvK-nummer voor de KvK-server)
# Default (niet gezet): 68750110 — Robin Vogel / Test BV Donald (KvK Test API)
# Alternatief: 85234567 — Claudia van Dam / Koffiezaak Noon (volledig mock,
# informatieplicht energiebesparing geldt; zie PDR-007). Herstart de host na wijziging.
# DEMO_KVK_NUMMER=85234567

# Host-instellingen
VLAM_HOST=0.0.0.0
VLAM_PORT=8000

# Security
# CORS: komma-gescheiden whitelist. Leeg laten = geen CORS toegestaan (veilige
# default). Zet expliciet "*" voor lokale dev/PoC (alleen op je eigen machine)
# of een concrete whitelist voor productie:
#   ALLOWED_ORIGINS=https://moza.overheid.nl,https://moza-test.overheid.nl
ALLOWED_ORIGINS=http://localhost:8080
# API-keys via request-headers accepteren (x-vlam-api-key / x-claude-api-key).
# Default: false. Zet op true voor demos waarin de frontend een eigen key meestuurt.
ALLOW_API_KEY_OVERRIDE=false
